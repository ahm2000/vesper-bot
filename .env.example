# Discord bot token — from https://discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_TOKEN=

# Application (client) ID — from Discord Developer Portal > your app > General Information > Application ID
CLIENT_ID=

# Optional: guild ID for instant command registration during development.
# Leave empty and use `python -m src.deploy --global` for production (global commands take up to 1 hour to propagate).
DEV_GUILD_ID=

# Optional: Discord webhook URL. If set, the bot posts crash/error alerts here.
# Create one in a Discord channel: Channel Settings > Integrations > Webhooks > New Webhook.
ERROR_WEBHOOK_URL=

# Bot owner's Discord user ID (for owner-only debug commands, optional)
OWNER_ID=
